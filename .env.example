# Copy to .env.local and fill from Firebase Console > Project settings > General > Your apps.
# Do not commit .env.local or any private service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kandb-net-service
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_FUNCTIONS_URL=https://asia-south1-kandb-netservice.cloudfunctions.net/api
