# Public Firebase Web App configuration for project kandb-net-sevice.
# Copy to .env.local for local builds. Never commit .env.local or private credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kandb-net-sevice
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public base URL of the Netlify site that hosts the K&B API function.
# Example: https://your-kandb-site.netlify.app
VITE_API_BASE_URL=
