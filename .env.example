# Public Firebase Web app configuration (used only if a client SDK feature needs it).
# Sign-in uses K&B user ID/password sessions, not Firebase Authentication.
# Never commit private service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=kandb-net-sevice
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_FUNCTIONS_URL=https://asia-south1-kandb-net-sevice.cloudfunctions.net/api
