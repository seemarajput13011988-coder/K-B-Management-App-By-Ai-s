rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.active == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(myProfilePath()).data.role == 'admin';
    }

    // A worker can read their own profile. Admins can read staff profiles.
    // Profile creation, role changes and activation remain administrator-only
    // server/console operations until the corresponding Spark rules are added.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // All other collections stay closed until each collection receives
    // its own role- and ownership-checked rules during the Spark migration.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
